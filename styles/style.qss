/* style.qss - 全局样式表 */

QMainWindow {
    background-color: #333;
    color: #eee;
}
QSplitter::handle {
    background-color: #555;
    width: 5px;
}
QSplitter::handle:hover {
    background-color: #777;
}

/* Left Panel */
QWidget#leftPanel {
    background-color: #2b2b2b;
}
QLineEdit {
    background-color: #444;
    border: 1px solid #555;
    padding: 5px;
    border-radius: 3px;
    color: #eee;
    selection-background-color: #0078d7;
}
QPushButton {
    background-color: #555;
    border: none;
    color: #eee;
    padding: 8px 12px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #666;
}
QPushButton:pressed {
    background-color: #444;
}
/* Specific styles for different button sizes based on icon size */
QPushButton[iconSize="32,32"] {
    padding: 0px; /* Reset padding for small icon buttons */
}
QPushButton[iconSize="48,48"] {
    padding: 0px;
}
QPushButton[iconSize="60,60"] {
    padding: 0px;
}


QTableWidget {
    background-color: #2b2b2b;
    border: 1px solid #444;
    gridline-color: #444;
    color: #eee;
    selection-background-color: #0078d7;
    selection-color: #fff;
    alternate-background-color: #333; /* For striped rows */
}
QTableWidget::item {
    padding: 5px;
}
QTableWidget::item:selected {
    background-color: #0078d7;
    color: #fff;
}
QHeaderView::section {
    background-color: #444;
    color: #eee;
    padding: 5px;
    border: 1px solid #555;
}

/* Right Panel */
QWidget#rightPanel {
    background-color: #222;
}
QLabel {
    color: #eee;
}
QLabel#songTitleLabel {
    font-size: 20px;
    font-weight: bold;
}
QLabel#artistLabel {
    font-size: 14px;
}
QLabel#albumLabel {
    font-size: 12px;
    color: #ccc;
}
QLabel#otherInfoLabel {
    font-size: 10px;
    color: #aaa;
}

QSlider::groove:horizontal {
    border: 1px solid #bbb;
    background: #555;
    height: 8px;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #0078d7;
    border: 1px solid #0078d7;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}
QSlider::sub-page:horizontal {
    background: #00aaff;
    border-radius: 4px;
}
QSlider::add-page:horizontal {
    background: #555;
    border-radius: 4px;
}

/* Volume Slider Specific */
QSlider#volumeSlider::groove:horizontal {
     height: 4px;
     border-radius: 2px;
}
QSlider#volumeSlider::handle:horizontal {
    width: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QWidget#visualizationLyricsArea {
    border: 1px solid #777;
    background-color: #1a1a1a;
    border-radius: 5px;
}
